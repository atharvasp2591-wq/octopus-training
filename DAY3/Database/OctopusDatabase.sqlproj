<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="Current">
  <PropertyGroup>
    <Name>OctopusDatabase</Name>
    <ProjectGuid>{12345678-1234-1234-1234-123456789012}</ProjectGuid>
    <SqlServerVersion>Sql150</SqlServerVersion>
    <SSDTUseFullyQualifiedName>true</SSDTUseFullyQualifiedName>
    <RecreateDatabase>False</RecreateDatabase>
    <DeploymentVersion>1.0.0.0</DeploymentVersion>
    <DefaultSchema>dbo</DefaultSchema>
    <DacMajorVersion>1</DacMajorVersion>
    <DacMinorVersion>0</DacMinorVersion>
    <DacBuildNumber>0</DacBuildNumber>
    <DacRevisionNumber>0</DacRevisionNumber>
    <NetFxTargetsPath></NetFxTargetsPath>
  </PropertyGroup>
  <ItemGroup>
    <Build Include="dbo\Tables\Users.sql" />
    <Build Include="dbo\StoredProcedures\sp_GetUserById.sql" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\SSDT\Microsoft.Data.Tools.Schema.SqlTasks.targets" />
</Project>
